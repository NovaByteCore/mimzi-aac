# Copy to .env.local and adjust. Only variables starting with VITE_ reach the app,
# and everything that reaches the app is PUBLIC — never put secrets here.

# Display name shown in the app header and install prompt.
VITE_APP_NAME=Mimzi

# Base path if the app is served from a sub-folder (e.g. /mimzi/). Default: /
VITE_BASE_PATH=/

# Default text-to-speech language (BCP-47). The device chooses the closest voice.
VITE_DEFAULT_SPEECH_LANG=en-US

# Google sign-in, Drive sync and Google Photos (optional). See docs/GOOGLE_SETUP.md.
# The OAuth *client ID* is public by design (it ships in the web page). Never put a
# client *secret* here — Mimzi doesn't need one.
VITE_GOOGLE_CLIENT_ID=

# Path of the Google Photos pass-through function (netlify/functions or functions/api).
VITE_PHOTOS_PROXY_URL=/api/photo

# Symbol licences. Mimzi is for personal, non-commercial use by default, so ARASAAC
# (CC BY-NC-SA) is the default symbol style. Set to true for ANY commercial deployment:
# ARASAAC and other non-commercial symbols then switch off automatically.
VITE_COMMERCIAL_USE=false

# Path of the OpenSymbols search function (netlify/functions/symbols.mts or functions/api/symbols.ts).
VITE_OPENSYMBOLS_URL=/api/symbols

# OPENSYMBOLS_SECRET is NOT a VITE_ variable and must never be in this file or in Git.
# Set it only in the hosting dashboard (Netlify → Environment variables). See docs/SYMBOLS.md.
